# Environment & Core Django Settings
ENVIRONMENT=development
DEBUG=True
DJANGO_SECRET_KEY=local-dev-insecure-secret-key-32-chars-min
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# PostgreSQL Database
DATABASE_URL=postgresql://gqt_portal_user:gqt_portal_dev_password@localhost:5432/gqt_portal_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=jwt-local-dev-secret-key-32-chars-min

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Sandboxed Judge
JUDGE_SERVICE_URL=http://localhost:2358
JUDGE_SERVICE_API_KEY=

# External AI Provider
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

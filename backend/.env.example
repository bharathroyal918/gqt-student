# ==============================================================================
# GQT BACKEND - SUPABASE & DJANGO ENVIRONMENT CONFIGURATION
# ==============================================================================
ENVIRONMENT=development
DEBUG=True
TIMEZONE=Asia/Kolkata
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=gqt-django-dev-secret-key-32-chars-minimum-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Supabase Database Configuration ---
# Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Connection Pooler (Port 6543 / Supavisor Transaction mode):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_SSLMODE=require
CONN_MAX_AGE=0

# --- Supabase API & Cloud Services ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=media

# --- Redis & Celery ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- JWT Authentication ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=gqt-jwt-dev-secret-key-32-chars-minimum-change-me

# --- CORS & CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Sandboxed Judge & AI ---
JUDGE_SERVICE_URL=http://localhost:2358
JUDGE_SERVICE_API_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

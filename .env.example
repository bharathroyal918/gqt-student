# ==============================================================================
# GQT STUDENT PORTAL - SUPABASE & ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Never commit real production secret keys or credentials to Git.
# 2. Copy this file to `.env` in the root and `backend/.env`.
# 3. Replace placeholders below with your actual Supabase project credentials.
#    Find these in Supabase Dashboard -> Project Settings -> Database & API.

# --- Environment & Core Django ---
ENVIRONMENT=development
DEBUG=True
TIMEZONE=Asia/Kolkata
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=gqt-django-secure-secret-key-32-chars-minimum-change-for-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Supabase Database Configuration ---
# Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# Connection Pooler (Port 6543 / Supavisor Transaction mode):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_SSLMODE=require
CONN_MAX_AGE=0

# --- Supabase API & Cloud Services ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=media

# --- Redis & Celery Infrastructure ---
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- JWT Authentication ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=gqt-jwt-secure-signing-key-32-chars-minimum-change-for-prod

# --- CORS & CSRF Security ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Sandboxed Code Execution Provider (Judge0) ---
JUDGE_SERVICE_URL=http://localhost:2358
JUDGE_SERVICE_API_KEY=
JUDGE_SUBMISSION_TIMEOUT_SECONDS=10
JUDGE_MAX_EXECUTION_TIME_SECONDS=5.0
JUDGE_MAX_MEMORY_MB=256

# --- External AI / LLM Mentor Provider ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
AI_MAX_TOKENS_PER_REQUEST=2048
AI_HOURLY_RATE_LIMIT_PER_STUDENT=30

# --- SMS / OTP Provider ---
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_SENDER_ID=GQTPOR
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Transactional Email SMTP Provider ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Global Quality Technologies <notifications@gqt.edu>

# --- Frontend Variables ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SUPABASE_ANON_KEY
VITE_APP_NAME=GQT Student Portal
VITE_APP_ENV=development

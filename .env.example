# ==============================================================================
# GQT STUDENT PORTAL - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Never commit production values, private keys, or credentials to Git.
# 2. Copy this file to `.env` in your deployment environment and populate values.
# 3. Use secrets managers (e.g. AWS Secrets Manager, Vault) in CI/CD pipelines.

# --- Environment & Core Django ---
ENVIRONMENT=production
DEBUG=False
TIMEZONE=Asia/Kolkata
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-cryptographically-secure-random-key-with-64-characters-min
DJANGO_ALLOWED_HOSTS=portal.gqt.edu,api.portal.gqt.edu

# --- Database Configuration (PostgreSQL with Connection Pooling) ---
DATABASE_URL=postgresql://gqt_db_user:YOUR_STRONG_DB_PASSWORD@postgres-cluster.internal:5432/gqt_portal_prod
CONN_MAX_AGE=600

# --- Redis & Celery Infrastructure ---
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis-cluster.internal:6379/0
CELERY_BROKER_URL=redis://:YOUR_REDIS_PASSWORD@redis-cluster.internal:6379/1
CELERY_RESULT_BACKEND=redis://:YOUR_REDIS_PASSWORD@redis-cluster.internal:6379/2

# --- JWT Authentication ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=generate-a-separate-strong-jwt-signing-secret-key-64-chars

# --- CORS & CSRF Security ---
CORS_ALLOWED_ORIGINS=https://portal.gqt.edu
CSRF_TRUSTED_ORIGINS=https://portal.gqt.edu,https://api.portal.gqt.edu

# --- HTTPS & Security Headers ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Object Storage / Media Assets (AWS S3 / Cloudflare R2 / MinIO) ---
DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
AWS_ACCESS_KEY_ID=YOUR_AWS_OR_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_OR_S3_SECRET_KEY
AWS_STORAGE_BUCKET_NAME=gqt-portal-media-prod
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=media.portal.gqt.edu
AWS_DEFAULT_ACL=private

# --- Sandboxed Code Execution Provider (Judge0 Enterprise / Isolated Runner) ---
JUDGE_SERVICE_URL=https://judge0.internal.gqt.edu
JUDGE_SERVICE_API_KEY=YOUR_JUDGE0_SECURE_AUTH_TOKEN
JUDGE_SUBMISSION_TIMEOUT_SECONDS=10
JUDGE_MAX_EXECUTION_TIME_SECONDS=5.0
JUDGE_MAX_MEMORY_MB=256

# --- External AI / LLM Mentor Provider ---
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_SECURE_GEMINI_OR_OPENAI_API_KEY
AI_MODEL_NAME=gemini-1.5-flash
AI_MAX_TOKENS_PER_REQUEST=2048
AI_HOURLY_RATE_LIMIT_PER_STUDENT=30

# --- SMS / OTP Provider (Twilio / AWS SNS / Fast2SMS) ---
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=YOUR_SMS_ACCOUNT_SID
SMS_AUTH_TOKEN=YOUR_SMS_AUTH_TOKEN
SMS_SENDER_ID=GQTPOR
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Transactional Email SMTP Provider (SendGrid / AWS SES / Postmark) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=YOUR_SENDGRID_OR_SES_API_KEY
DEFAULT_FROM_EMAIL=Global Quality Technologies <notifications@gqt.edu>

# --- Error Monitoring & Telemetry ---
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Frontend Build Variables ---
VITE_API_BASE_URL=https://api.portal.gqt.edu/api/v1
VITE_APP_NAME=GQT Student Portal
VITE_APP_ENV=production
